                    Ok(p) => {
                        let _ = tun.write(p.raw_ref());
                    }
                    Err(e) => match e {
                        mpsc::TryRecvError::Empty => {}
                        mpsc::TryRecvError::Disconnected => {
                            ::core::panicking::panic("explicit panic")
                        }
